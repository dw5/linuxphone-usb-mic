    ("lower", "Lower, natural", f"{RUBBERBAND} semitones=-4"),
    # Ring modulation is the classic robot; a short echo on top makes it metallic.
    ("robot", "Robot", f"{RINGMOD} modulation-depth=1 frequency=100 ! audioecho "
