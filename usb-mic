    def on_close(self, *_):
        self.close_music()
        self.stop_speech()
        self.stop_effects()
        self.stop_talk()
        self.stop_listen()
        self.stop_record(wait=True)
        self.restore_ports()
        return False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text))

    # Microphone

    def tick(self):
        if self.holding:
            # pactl runs on this thread; while it waits, letting go of the button
            # wouldn't be noticed and the PC would keep hearing you.
            return GLib.SOURCE_CONTINUE
        self.refresh_choices()
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def refresh(self):
        if self.busy:
            return
        on = mic_on()
        self.sink = gadget_sink() if on else None
        if not self.sink:
            # The microphone went away: nothing can reach the PC any more.
            if self.music:
                self.close_music()
            self.stop_speech(pc_only=True)
            for pb, out in list(self.effects.items()):
                if out[0] is not None:
                    self.drop_effect(pb)
            self.stop_talk()
            self.stop_listen()
            self.stop_record()
        self.syncing = True
        self.mic.set_active(on)
        self.talk_row.set_active(self.talk is not None)
        self.listen_row.set_active(self.listen is not None)
        self.syncing = False
        for w in (self.talk_row, self.listen_row, self.rec_btn):
            w.set_sensitive(bool(self.sink))
        if not on:
            self.mic.set_subtitle("Off")
        elif self.sink:
            self.mic.set_subtitle("On")
        else:
            self.mic.set_subtitle("On, waiting for the phone's sound system")

    def on_mic(self, row, _param):
        if self.syncing or self.busy:
            return
        want = row.get_active()
        if not want:
            self.close_music()
            self.stop_speech()
            self.stop_effects()
            self.stop_talk()
            self.stop_listen()
            self.stop_record()
        self.busy = True
        row.set_sensitive(False)
        row.set_subtitle("Turning on…" if want else "Turning off…")
        # Plugging the microphone in makes PulseAudio switch the phone's own default
        # speaker and microphone to it, so note them now and put them back after.
        defaults = (pactl("get-default-sink"), pactl("get-default-source"))
        try:
            proc = Gio.Subprocess.new(["pkexec", HELPER, "on" if want else "off"],
                                      Gio.SubprocessFlags.STDERR_PIPE)
            proc.communicate_utf8_async(None, None, self.mic_done, want, defaults)
        except GLib.Error as e:
            self.toast(f"Couldn't run the helper: {e.message[:80]}")
            self.finish_mic()

    def mic_done(self, proc, result, want, defaults):
        try:
            _, _, err = proc.communicate_utf8_finish(result)
            ok = proc.get_successful()
        except GLib.Error as e:
            ok, err = False, e.message
        if not ok:
            self.toast(f"Couldn't change the USB headset: {(err or '').strip()[:80]}")
            self.finish_mic()
            return
        if want:
            self.restore_tries = 10
            GLib.timeout_add(500, self.restore_defaults, defaults)
        else:
            self.finish_mic()

    def restore_defaults(self, defaults):
        """Wait for PulseAudio to pick up the headset, then undo its switch of the phone's
        defaults to it. Only defaults now pointing at the headset are changed back."""
        sink = gadget_sink()
        self.restore_tries -= 1
        if not sink and self.restore_tries > 0:
            return GLib.SOURCE_CONTINUE
        gadget = {d["name"] for kind in ("sinks", "sources") for d in devices(kind, fresh=True)
                  if is_gadget(d)}
        for kind, was in zip(("sink", "source"), defaults):
            if was and was not in gadget and pactl(f"get-default-{kind}") in gadget:
                pactl(f"set-default-{kind}", was)
        self.finish_mic()
        return GLib.SOURCE_REMOVE

    def finish_mic(self):
        self.busy = False
        self.mic.set_sensitive(True)
        self.refresh()

    # The phone's own microphone and speaker

    def refresh_choices(self):
        """Fill the pickers, keeping the current choice (or the saved one on start)."""
        for kind, (row, old) in self.pickers.items():
            new = choices(kind)
            if [c[:2] for c in new] == [c[:2] for c in old]:
                continue
            key = old[row.get_selected()][0] if old else self.saved.get(kind, "")
            keys = [c[0] for c in new]
            self.pickers[kind][1] = new
            self.syncing = True
            row.set_model(Gtk.StringList.new([c[1] for c in new]))
            row.set_selected(keys.index(key) if key in keys else 0)
            self.syncing = False
            if not old or key not in keys:
                self.use_choice(kind)

    def speaker(self):
        """Where the phone plays: the picked output, or the phone's own default."""
        return self.choice("sinks")[0] or phone_speaker()

    def choice(self, kind):
        """(device, port) picked for "sinks" or "sources"; device None is the phone's choice."""
        row, items = self.pickers[kind]
        i = row.get_selected()
        return items[i][2:] if 0 <= i < len(items) else (None, None)

    def on_pick(self, row, _param, kind):
        if self.syncing:
            return
        items = self.pickers[kind][1]
        self.saved[kind] = items[row.get_selected()][0]
        self.save_settings()
        self.use_choice(kind)

    def use_choice(self, kind):
        """Switch the port if needed, then move whatever is playing or listening."""
        device, port = self.choice(kind)
        self.restore_ports(kind, keep=device)
        if port and active_port(kind, device) != port:
            self.ports_was.setdefault((kind, device), active_port(kind, device))
            pactl(f"set-{kind[:-1]}-port", device, port)
        if kind == "sinks":
            for out in [self.music_out, *self.effects.values()]:
                if out:
                    out[2].set_property("device", self.speaker())
            if self.listen:
                self.stop_listen()
                self.start_listen()
        elif self.talk:
            self.stop_talk()
            self.start_talk()

    def restore_ports(self, only_kind=None, keep=None):
        """Put back ports this app changed: all of them, or those of one kind apart
        from the device still in use."""
        for (kind, device), port in list(self.ports_was.items()):
            if only_kind and (kind != only_kind or device == keep):
                continue
            if port:
                pactl(f"set-{kind[:-1]}-port", device, port)
            del self.ports_was[(kind, device)]

    # Playback

    def player(self, path, volume=1.0, to_pc=True):
        """A player for a file. Its sound goes to the PC and, muted unless asked for,
        to the phone's own speaker; with to_pc False only to the phone.
        Returns (player, outputs): outputs is (volume to the PC or None, volume on the
        phone, the phone's sink element, master volume)."""
        if to_pc and not self.sink:
            self.toast("Turn the USB headset on first")
            return None, None
        try:
            return self.build_player(path, volume, to_pc)
        except RuntimeError as e:
            self.toast(f"Can't play: {e}")
            return None, None

    def build_player(self, path, volume, to_pc):
        # Not playbin: it hands its volume to whichever volume-capable element it finds
        # in a custom sink, which here was the phone's muted side, so the slider did nothing.
        out = Gst.Pipeline.new(None)
        dec = make("uridecodebin")
        dec.set_property("uri", Gio.File.new_for_path(str(path)).get_uri())
        conv = make("audioconvert")
        res = make("audioresample")
        master = make("volume")
        master.set_property("volume", volume)
        tee = make("tee")
        for e in (dec, conv, res, master, tee):
            out.add(e)
        conv.link(res)
        res.link(master)
        master.link(tee)

        def on_pad(_dec, pad):
            # Take the first audio stream; ignore cover art and the like.
            caps = pad.get_current_caps() or pad.query_caps(None)
            sinkpad = conv.get_static_pad("sink")
            if caps.get_structure(0).get_name().startswith("audio/") and not sinkpad.is_linked():
                pad.link(sinkpad)
        dec.connect("pad-added", on_pad)

        def branch(device, gadget):
            # The PC side stalls while the PC isn't recording. A leaky queue drops sound
            # there instead of holding up the phone side and the position.
            # While starting (and after a pause or seek) both sinks wait for the player to
            # be ready, and the decoder fills the queues meanwhile. The phone's queue has
            # to fill up first and hold the decoder back, otherwise the PC's leaky queue
            # throws away the start: it lost the first second of every sound.
            q = make("queue")
            q.set_property("max-size-buffers", 0)
            q.set_property("max-size-bytes", 0)
            q.set_property("max-size-time", (500 if gadget else 200) * Gst.MSECOND)
            if gadget:
                q.set_property("leaky", 2)  # downstream: drop the oldest
            vol = make("volume")
            sink = make("pulsesink")
            if device:
                sink.set_property("device", device)
            if gadget:
                # The USB side runs on the PC's clock, not the phone's. Syncing it to the
                # phone's clock made it throw sound away as late: seconds-long gaps.
                sink.set_property("sync", False)
            for e in (q, vol, sink):
                out.add(e)
            tee.link(q)
            q.link(vol)
            vol.link(sink)
            return vol, sink

        pc = branch(self.sink, True)[0] if to_pc else None
        local, local_sink = branch(self.speaker(), False)
        pb = out
        # Run on the system clock, so a stalled PC side can't stop time for everything.
        pb.use_clock(Gst.SystemClock.obtain())
        bus = pb.get_bus()
        bus.add_signal_watch()
        bus.connect("message::eos", self.on_end, pb)
        bus.connect("message::error", self.on_error, pb)
        return pb, (pc, local, local_sink, master)

    def apply_outputs(self):
        """Play on the phone too, or not, to match the switch. Previews always do."""
        hear = self.monitor.get_active()
        for out in [self.music_out, *self.effects.values()]:
            if out and out[0] is not None:
                out[1].set_property("mute", not hear)

    def on_end(self, _bus, _msg, pb):
        self.ending.pop(pb, None)
        if pb is self.music:
            self.rewind_music()
        else:
            self.drop_effect(pb)

    def on_error(self, _bus, msg, pb):
        err, _ = msg.parse_error()
        self.toast(f"Couldn't play: {err.message[:80]}")
        if pb is self.music:
            self.close_music()
        else:
            self.drop_effect(pb)

    def pick_music(self, *_):
        dlg = Gtk.FileDialog(title="Choose music")
        dlg.open(self, None, self.music_chosen)

    def music_chosen(self, dlg, result):
        try:
            f = dlg.open_finish(result)
        except GLib.Error:
            return
        self.close_music()
        self.music_file = f.get_path()
        self.music_row.set_title(GLib.markup_escape_text(Path(self.music_file).name))
        if self.sink:
            self.load_music()
            if self.music:
                self.music.set_state(Gst.State.PAUSED)  # shows the length

    def load_music(self):
        self.music, self.music_out = self.player(self.music_file, self.volume.get_value())
        self.position.set_sensitive(bool(self.music))
        self.apply_outputs()

    def toggle_music(self, *_):
        if not self.music_file:
            self.pick_music()
            return
        if not self.music:
            self.load_music()
            if not self.music:
                return
        # Go by what was last asked for: the player takes a moment to get there.
        self.music_want = not self.music_want
        if self.music_want:
            self.music.set_state(Gst.State.PLAYING)
        else:
            ok, pos = self.position_of(self.music, self.music_out)
            self.music.set_state(Gst.State.PAUSED)
            if ok:
                # Throw away sound already queued for the PC, so resuming isn't stale.
                self.music.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH | Gst.SeekFlags.ACCURATE, pos)
        self.play_btn.set_icon_name("media-playback-pause-symbolic" if self.music_want
                                    else "media-playback-start-symbolic")

    def rewind_music(self):
        """Stop: pause and go back to the start, keeping the file loaded."""
        self.music_want = False
        if self.music:
            self.music.set_state(Gst.State.PAUSED)
            self.music.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH, 0)
            self.last_seek = 0.0
            self.position.set_value(0)
            self.pos_label.set_label(timecode(0))
        self.play_btn.set_icon_name("media-playback-start-symbolic")

    def close_music(self):
        if self.music:
            self.music.set_state(Gst.State.NULL)
            self.music.get_bus().remove_signal_watch()
            self.ending.pop(self.music, None)
            self.music = None
            self.music_out = None
        self.music_want = False
        self.play_btn.set_icon_name("media-playback-start-symbolic")
        self.position.set_sensitive(False)
        self.position.set_range(0, 1)
        self.position.set_value(0)
        self.pos_label.set_label(timecode(0))
        self.dur_label.set_label("–:––")

    def update_position(self):
        self.check_ends()
        if self.rec:
            r = self.rec
            try:
                size = r["path"].stat().st_size / 1e6
            except OSError:
                size = 0
            quiet = time.monotonic() - r["last"] > 1.0
            self.rec_row.set_subtitle(f"Recording {timecode(r['ns'])} · {size:.1f} MB"
                                      + (" · no sound from the PC" if quiet else ""))
        if self.talk and time.monotonic() - self.level_at > 0.5:
            self.meter.set_value(0)  # no readings: don't leave a stale level up
        # Leave the slider alone just after a drag, until the seek has landed.
        if self.music and time.monotonic() - self.last_seek > 0.5:
            ok, dur = self.music.query_duration(Gst.Format.TIME)
            if ok and dur > 0:
                self.position.set_range(0, dur / Gst.SECOND)
                self.dur_label.set_label(timecode(dur))
            ok, pos = self.position_of(self.music, self.music_out)
            if ok:
                self.position.set_value(pos / Gst.SECOND)
                self.pos_label.set_label(timecode(pos))
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def position_of(pb, out):
        """Where playback is, read from the phone side: the PC side stalls while the PC
        isn't recording, and the player as a whole then reports a stale position."""
        ok, pos = out[2].query_position(Gst.Format.TIME) if out else (False, 0)
        return (ok, pos) if ok else pb.query_position(Gst.Format.TIME)

    def check_ends(self):
        """While the PC isn't recording, a player reaches its end on the phone side but
        never finishes, because the PC side is stuck. End it a second later instead."""
        now = time.monotonic()
        for pb, out in [(self.music, self.music_out), *self.effects.items()]:
            if not pb or (pb is self.music and not self.music_want):
                self.ending.pop(pb, None)
                continue
            ok_d, dur = pb.query_duration(Gst.Format.TIME)
            ok_p, pos = self.position_of(pb, out)
            if ok_d and ok_p and dur > 0 and pos >= dur - 50 * Gst.MSECOND:
                if now - self.ending.setdefault(pb, now) >= 1.0:
                    self.on_end(None, None, pb)
            else:
                self.ending.pop(pb, None)

    def on_seek(self, scale, _scroll, value):
        if not self.music:
            return True
        adj = scale.get_adjustment()
        value = min(max(value, adj.get_lower()), adj.get_upper())
        if not self.music.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH | Gst.SeekFlags.ACCURATE,
                                      int(value * Gst.SECOND)):
            self.toast("Couldn't jump there")
            return True
        self.ending.pop(self.music, None)
        self.last_seek = time.monotonic()
        self.pos_label.set_label(timecode(int(value * Gst.SECOND)))
        return False

    def on_volume(self, scale):
        if self.music_out:
            self.music_out[3].set_property("volume", scale.get_value())

    # Talking

    def on_talk(self, row, _param):
        if self.syncing:
            return
        if row.get_active():
            self.start_talk()
        else:
            self.stop_talk()

    def link(self, source, sink, on_error, meter=False, talk=False, probe=False):
        """A live pipeline from a PulseAudio source to a sink (None: the phone's default),
        kept short: a leaky queue drops sound rather than letting the delay grow.
        None if it can't be built."""
        try:
            return self.build_link(source, sink, on_error, meter, talk, probe)
        except (RuntimeError, GLib.Error) as e:
            self.toast(str(e))
            return None

    def build_link(self, source, sink, on_error, meter, talk, probe):
        pipe = Gst.Pipeline.new(None)
        src = make("pulsesrc")
        src.set_property("device", source)
        src.set_property("buffer-time", 40000)   # µs
        src.set_property("latency-time", 10000)
        q = make("queue")
        q.set_property("leaky", 2)
        q.set_property("max-size-time", 100 * Gst.MSECOND)
        conv = make("audioconvert")
        res = make("audioresample")
        out = make("pulsesink")
        if sink:
            out.set_property("device", sink)
        out.set_property("buffer-time", 60000)
        out.set_property("latency-time", 10000)
        out.set_property("sync", False)
        chain = [src, q, conv, res]
        if meter:
            # Right after the microphone, before the queue: the PC side stalls while the
            # PC isn't recording, and a meter after it would freeze. It measures your
            # own voice, before any effect: "am I loud enough".
            level = make("level")
            level.set_property("interval", 50 * Gst.MSECOND)
            chain.insert(1, level)
        if talk or probe:
            # WebRTC processing wants a fixed rate and 16-bit samples, on both sides.
            caps = make("capsfilter")
            caps.set_property("caps", Gst.Caps.from_string("audio/x-raw,format=S16LE,rate=48000"))
            chain.append(caps)
        if probe:
            # What the phone plays, for the talk side's echo canceller to subtract.
            echo = make("webrtcechoprobe")
            echo.set_property("name", ECHO_PROBE)
            chain += [echo, make("audioconvert")]
        if talk:
            clean = self.clean_row.get_active()
            cancel = self.echo_row.get_active() and self.listen is not None
            if clean or cancel:
                dsp = make("webrtcdsp")
                dsp.set_property("noise-suppression", clean)
                dsp.set_property("echo-cancel", cancel)
                dsp.set_property("gain-control", False)  # the user sets their own level
                dsp.set_property("delay-agnostic", True)
                if cancel:
                    dsp.set_property("probe", ECHO_PROBE)
                chain.append(dsp)
            # Push-to-talk mutes here, before the effect, so an echo can ring out.
            self.talk_gate = make("volume")
            self.talk_gate.set_property("mute", self.ptt_row.get_active() and not self.holding)
            chain.append(self.talk_gate)
            self.talk_effect = self.effect_bin()
            chain += [self.talk_effect, make("audioconvert"), make("audioresample")]
        chain.append(out)
        for e in chain:
            pipe.add(e)
        for a, b in zip(chain, chain[1:]):
            a.link(b)
        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", on_error)
        if meter:
            bus.connect("message::element", self.on_level)
        # One clock and one time origin for every live pipeline: the echo canceller
        # matches your voice (talk) against what the phone played (listen) by their
        # timestamps, which only line up if both count from the same moment.
        pipe.use_clock(Gst.SystemClock.obtain())
        pipe.set_start_time(Gst.CLOCK_TIME_NONE)
        pipe.set_base_time(self.base_time)
        pipe.set_state(Gst.State.PLAYING)
        return pipe

    def switch_off(self, row):
        if row.get_active():
            self.syncing = True
            row.set_active(False)
            self.syncing = False

    def start_talk(self):
        mic = self.choice("sources")[0] or phone_mic()
        if not self.sink or not mic:
            self.toast("Turn the USB headset on first" if not self.sink
                       else "Couldn't find the phone's microphone")
            self.switch_off(self.talk_row)
            return
        self.talk = self.link(mic, self.sink, self.on_talk_error, meter=True, talk=True)
        if not self.talk:
            self.switch_off(self.talk_row)
            return
        self.meter.set_value(0)
        self.meter_row.set_visible(True)
        self.apply_gate()

    def restart_talk(self):
        """Rebuild the talk pipeline with the current options, if talking."""
        if not self.talk:
            return
        self.swap_pending = False
        self.talk.set_state(Gst.State.NULL)
        self.talk.get_bus().remove_signal_watch()
        self.talk = None
        self.start_talk()

    def on_voice_option(self, row, _param, key):
        self.saved[key] = row.get_active()
        self.save_settings()
        self.restart_talk()

    def effect_bin(self):
        desc = self.voice_effects[self.effect_row.get_selected()][2]
        # audioconvert both sides: pitch, for one, only takes floating-point samples.
        return Gst.parse_bin_from_description(f"audioconvert ! {desc} ! audioconvert", True)

    def on_effect(self, row, _param):
        self.saved["effect"] = self.voice_effects[row.get_selected()][0]
        self.save_settings()
        if not self.talk or self.swap_pending:
            return  # a pending swap picks up the latest choice when it runs
        # Swap the effect while you talk: hold the sound just before the effect, then
        # change the graph on the main thread, then let the sound through again.
        pipe = self.talk
        pad = self.talk_effect.get_static_pad("sink").get_peer()
        if pad is None:
            self.restart_talk()
            return
        self.swap_pending = True

        def blocked(_pad, info):
            GLib.idle_add(self.swap_effect, pipe, pad, info.id)
            return Gst.PadProbeReturn.OK  # stays held until swap_effect removes the probe
        pad.add_probe(Gst.PadProbeType.BLOCK_DOWNSTREAM, blocked)

    def swap_effect(self, pipe, pad, probe_id):
        if pipe is not self.talk or not self.swap_pending:
            return GLib.SOURCE_REMOVE  # talking stopped or restarted meanwhile
        self.swap_pending = False
        old = self.talk_effect
        after = old.get_static_pad("src").get_peer()
        try:
            new = self.effect_bin()
        except GLib.Error as e:
            pad.remove_probe(probe_id)
            self.toast(f"Can't use that effect: {e.message[:60]}")
            return GLib.SOURCE_REMOVE
        # Bin.add returns None or True depending on the PyGObject version; it raises
        # when it fails, so check where the bin ended up instead.
        ok = (after is not None
              and pad.unlink(old.get_static_pad("sink"))
              and old.get_static_pad("src").unlink(after))
        if ok:
            try:
                pipe.add(new)
            except Exception:
                pass
            ok = new.get_parent() is pipe
        ok = (ok
              and pad.link(new.get_static_pad("sink")) == Gst.PadLinkReturn.OK
              and new.get_static_pad("src").link(after) == Gst.PadLinkReturn.OK
              and new.sync_state_with_parent())
        if not ok:
            self.toast("Couldn't change the effect; restarting the voice")
            self.restart_talk()
            return GLib.SOURCE_REMOVE
        self.talk_effect = new
        pad.remove_probe(probe_id)
        old.set_state(Gst.State.NULL)
        pipe.remove(old)
        return GLib.SOURCE_REMOVE

    def save_settings(self):
        try:
            CONFIG.write_text(json.dumps(self.saved))
        except OSError:
            pass

    def on_level(self, _bus, msg):
        st = msg.get_structure()
        if st.get_name() != "level":
            return
        now = time.monotonic()
        self.level_at = now
        rms = min(1.0, max(0.0, (max(st.get_value("rms")) + 60) / 60))
        cur = self.meter.get_value()
        # Rise at once, fall over about 200 ms: steady to read, still quick.
        self.meter.set_value(rms if rms >= cur else cur + (rms - cur) * 0.25)
        if max(st.get_value("peak")) > -3:
            self.clip_until = now + 1.0
        if (now < self.clip_until) != self.meter.has_css_class("clipping"):
            (self.meter.add_css_class if now < self.clip_until else self.meter.remove_css_class)("clipping")

    def on_talk_error(self, _bus, msg):
        err, _ = msg.parse_error()
        self.toast(f"Talking stopped: {err.message[:80]}")
        self.stop_talk()

    def stop_talk(self):
        self.swap_pending = False
        if self.talk:
            self.talk.set_state(Gst.State.NULL)
            self.talk.get_bus().remove_signal_watch()
            self.talk = None
        self.talk_gate = None
        self.holding = False
        self.meter_row.set_visible(False)
        self.apply_gate()
        self.switch_off(self.talk_row)

    # Push to talk

    def on_ptt(self, row, _param):
        self.saved["ptt"] = row.get_active()
        self.save_settings()
        self.apply_gate()

    def set_holding(self, down):
        self.holding = down
        self.apply_gate()

    def apply_gate(self):
        """Open the microphone to the PC unless push-to-talk is on and the button is up."""
        ptt = self.ptt_row.get_active()
        open_ = not ptt or self.holding
        if self.talk_gate:
            self.talk_gate.set_property("mute", not open_)
        self.hold_row.set_visible(ptt and self.talk is not None)
        self.hold_btn.set_label("Talking…" if self.holding else "Hold to talk")
        (self.hold_btn.add_css_class if self.holding and self.talk
         else self.hold_btn.remove_css_class)("destructive-action")
        self.talk_row.set_subtitle("Muted until you hold the button" if self.talk and not open_
                                   else "The phone's microphone goes to the PC")

    # Listening to the PC

    def on_listen(self, row, _param):
        if self.syncing:
            return
        if row.get_active():
            self.start_listen()
        else:
            self.stop_listen()

    def start_listen(self):
        src = gadget_source() if self.sink else None
        if not src:
            self.toast("Turn the USB headset on first")
            self.switch_off(self.listen_row)
            return
        self.listen = self.link(src, self.speaker(), self.on_listen_error, probe=True)
        if not self.listen:
            self.switch_off(self.listen_row)
        elif self.echo_row.get_active():
            self.restart_talk()  # now there's an echo to cancel

    def on_listen_error(self, _bus, msg):
        err, _ = msg.parse_error()
        self.toast(f"Listening stopped: {err.message[:80]}")
        self.stop_listen()

    def stop_listen(self):
        if self.listen:
            self.listen.set_state(Gst.State.NULL)
            self.listen.get_bus().remove_signal_watch()
            self.listen = None
            if self.echo_row.get_active():
                self.restart_talk()  # its echo canceller lost what it listened to
        self.switch_off(self.listen_row)

    # Recording the PC

    def toggle_record(self, *_):
        if self.rec:
            self.stop_record()
        else:
            self.start_record()

    def start_record(self):
        src = gadget_source() if self.sink else None
        if not src:
            self.toast("Turn the USB headset on first")
            return
        try:
            path = self.new_recording_file()
        except OSError as e:
            self.toast(f"Couldn't create a file in {RECORDINGS}: {e.strerror}")
            return
        pipe = Gst.Pipeline.new(None)
        try:
            chain = [make(n) for n in
                     ("pulsesrc", "capsfilter", "queue", "audioconvert", "flacenc", "filesink")]
        except RuntimeError as e:
            path.unlink(missing_ok=True)
            self.toast(f"Can't record: {e}")
            return
        src_el, caps, queue, _, enc, sink = chain
        src_el.set_property("device", src)
        # What the USB link carries; left open, PulseAudio may hand over less.
        caps.set_property("caps", Gst.Caps.from_string("audio/x-raw,rate=48000,channels=2"))
        sink.set_property("location", str(path))
        rec = {"pipe": pipe, "path": path, "enc": enc, "queue": queue, "ns": 0, "last": 0.0,
               "stopping": False, "done": False, "timer": 0}

        # Count what actually arrives: the PC only sends sound while it's playing to us.
        def counted(_pad, info):
            buf = info.get_buffer()
            if buf and buf.duration != Gst.CLOCK_TIME_NONE:
                rec["ns"] += buf.duration
            rec["last"] = time.monotonic()
            return Gst.PadProbeReturn.OK
        src_el.get_static_pad("src").add_probe(Gst.PadProbeType.BUFFER, counted)
        for e in chain:
            pipe.add(e)
        for a, b in zip(chain, chain[1:]):
            a.link(b)
        bus = pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_record_error, rec)
        bus.connect("message::eos", lambda *_: self.finish_record(rec, True))
        if pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            pipe.set_state(Gst.State.NULL)
            bus.remove_signal_watch()
            path.unlink(missing_ok=True)
            self.toast("Couldn't start recording")
            return
        self.rec = rec
        self.rec_btn.set_icon_name("media-playback-stop-symbolic")
        self.rec_btn.add_css_class("destructive-action")

    @staticmethod
    def new_recording_file():
        """Reserve a new file, never reusing an existing name."""
        RECORDINGS.mkdir(parents=True, exist_ok=True)
        base = time.strftime("PC %Y-%m-%d %H-%M-%S")
        for n in range(1, 1000):
            path = RECORDINGS / (f"{base}.flac" if n == 1 else f"{base} ({n}).flac")
            try:
                os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644))
                return path
            except FileExistsError:
                continue
        raise OSError(17, "too many recordings with the same name")

    def on_record_error(self, _bus, msg, rec):
        err, _ = msg.parse_error()
        if rec["stopping"]:
            self.finish_record(rec, False)
            return
        self.toast(f"Recording stopped: {err.message[:80]}")
        self.stop_record(rec)

    def stop_record(self, rec=None, wait=False):
        """Finish the file properly, so the FLAC header gets its final length. The
        end-of-stream goes in at the encoder: sent to the pipeline, it waits for the
        source, which blocks for good while the PC sends nothing. Normally this
        returns at once and finish_record() follows; with wait (closing), it blocks
        for up to 2 s."""
        rec = rec or self.rec
        if not rec or rec["stopping"]:
            return
        rec["stopping"] = True
        if rec is self.rec:
            self.rec = None
            self.rec_btn.set_icon_name("media-record-symbolic")
            self.rec_btn.remove_css_class("destructive-action")
            self.rec_row.set_subtitle("Saves what the PC plays, as FLAC")

        def idle(_pad, _info):
            rec["enc"].get_static_pad("sink").send_event(Gst.Event.new_eos())
            return Gst.PadProbeReturn.REMOVE
        rec["queue"].get_static_pad("src").add_probe(Gst.PadProbeType.IDLE, idle)
        if wait:
            msg = rec["pipe"].get_bus().timed_pop_filtered(
                2 * Gst.SECOND, Gst.MessageType.EOS | Gst.MessageType.ERROR)
            self.finish_record(rec, msg is not None and msg.type == Gst.MessageType.EOS)
        else:
            rec["timer"] = GLib.timeout_add_seconds(3, self.finish_record, rec, False)

    def finish_record(self, rec, ok):
        if rec["done"]:
            return GLib.SOURCE_REMOVE
        rec["done"] = True
        if rec["timer"]:
            GLib.source_remove(rec["timer"])
            rec["timer"] = 0
        rec["pipe"].set_state(Gst.State.NULL)
        rec["pipe"].get_bus().remove_signal_watch()
        path = rec["path"]
        if rec["ns"] == 0:
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
            self.toast("Nothing recorded: the PC didn't play anything to Terminal Headset")
            return GLib.SOURCE_REMOVE
        title = f"Saved {path.name}" if ok else f"Saved {path.name}, but its end may be cut off"
        toast = Adw.Toast(title=title, button_label="Show")
        toast.connect("button-clicked", lambda *_: self.open_recordings())
        self.toasts.add_toast(toast)
        return GLib.SOURCE_REMOVE

    def open_recordings(self):
        try:
            RECORDINGS.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            self.toast(f"Couldn't make {RECORDINGS}: {e.strerror}")
            return
        launcher = Gtk.FileLauncher.new(Gio.File.new_for_path(str(RECORDINGS)))

        def done(lnch, result):
            try:
                lnch.launch_finish(result)
            except GLib.Error as e:
                self.toast(f"Couldn't open the folder: {e.message[:60]}")
        launcher.launch(self, None, done)

    # Soundboard

    def load_board(self):
        while (child := self.grid.get_first_child()):
            self.grid.remove(child)
        files = sorted(p for p in SOUNDS.glob("*") if p.suffix.lower() in AUDIO) if SOUNDS.is_dir() else []
        for p in files:
            b = Gtk.Button(label=p.stem)
            b.get_child().set_ellipsize(3)  # Pango.EllipsizeMode.END
            b.set_size_request(-1, 64)
            b.connect("clicked", self.play_effect, p)
            hold = Gtk.GestureLongPress()
            hold.connect("pressed", self.preview_effect, p)
            b.add_controller(hold)
            self.grid.append(b)
        self.empty.set_visible(not files)
        self.hint.set_visible(bool(files))

    def add_sounds(self, *_):
        dlg = Gtk.FileDialog(title="Add sounds")
        dlg.open_multiple(self, None, self.sounds_chosen)

    def sounds_chosen(self, dlg, result):
        try:
            files = dlg.open_multiple_finish(result)
        except GLib.Error:
            return
        added, failed = 0, 0
        for i in range(files.get_n_items()):
            name = files.get_item(i).get_path()
            src = Path(name) if name else None
            if not src or src.suffix.lower() not in AUDIO or src.parent == SOUNDS:
                continue
            try:
                SOUNDS.mkdir(parents=True, exist_ok=True)
                dest, n = SOUNDS / src.name, 2
                while dest.exists():  # keep both rather than overwrite
                    dest, n = SOUNDS / f"{src.stem} ({n}){src.suffix}", n + 1
                shutil.copy2(src, dest)
                added += 1
            except OSError:
                failed += 1
        self.load_board()
        self.toast(f"Added {added} sound{'s' if added != 1 else ''}"
                   + (f", {failed} couldn't be copied" if failed else ""))

    def play_effect(self, _btn, path, to_pc=True):
        pb, out = self.player(path, to_pc=to_pc)
        if pb:
            self.effects[pb] = out
            self.apply_outputs()
            pb.set_state(Gst.State.PLAYING)
        return pb

    def preview_effect(self, gesture, _x, _y, path):
        # Claiming the press stops the button from also sending it to the PC.
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        self.play_effect(None, path, to_pc=False)

    def drop_effect(self, pb):
        if pb not in self.effects:
            return
        pb.set_state(Gst.State.NULL)
        pb.get_bus().remove_signal_watch()
        del self.effects[pb]
        self.ending.pop(pb, None)
        path = self.temp_files.pop(pb, None)
        if path:
            path.unlink(missing_ok=True)
        if pb is self.saying:
            self.saying = None
            self.saying_file = None
            self.say_next()

    def stop_effects(self):
        self.stop_speech()
        for pb in list(self.effects):
            self.drop_effect(pb)

    # Type to speak: lines are spoken one after another, like soundboard sounds.

    def on_voice(self, row, _param):
        self.saved["voice"] = self.tts[row.get_selected()][0]
        self.save_settings()

    def say_typed(self, to_pc):
        text = " ".join(self.say_row.get_text().split())
        if not text or not self.tts:
            return
        if to_pc and not self.sink:
            self.toast("Turn the USB headset on first")
            return
        self.say_row.set_text("")
        self.say_queue.append((text, to_pc))
        self.say_next()

    def preview_typed(self, gesture, *_):
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)  # not to the PC as well
        self.say_typed(False)

    def say_next(self):
        if self.saying or not self.say_queue:
            return
        text, to_pc = self.say_queue.pop(0)
        voice = self.tts[self.voice_row.get_selected()] if self.tts else None
        if not voice:
            return
        path = None
        try:
            fd, name = GLib.file_open_tmp("usb-mic-say-XXXXXX.wav")
            os.close(fd)
            path = Path(name)
            proc = Gio.Subprocess.new([*voice[2], name], Gio.SubprocessFlags.STDIN_PIPE
                                      | Gio.SubprocessFlags.STDOUT_SILENCE
                                      | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as e:
            if path:
                path.unlink(missing_ok=True)
            self.toast(f"Couldn't speak: {e.message[:80]}")
            self.say_queue.clear()
            return
        self.saying = proc
        self.saying_file = (path, to_pc)
        proc.communicate_utf8_async(text + "\n", None, self.said, path, to_pc)

    def said(self, proc, result, path, to_pc):
        try:
            _, _, err = proc.communicate_utf8_finish(result)
            ok = proc.get_successful() and path.stat().st_size > 44
        except (GLib.Error, OSError) as e:
            ok, err = False, str(e)
        if proc is not self.saying:  # stopped meanwhile
            path.unlink(missing_ok=True)
            return
        self.saying = None
        self.saying_file = None
        pb = self.play_effect(None, path, to_pc) if ok else None
        if not pb:
            if not ok:
                self.toast(f"Couldn't speak: {(err or '').strip()[:80]}")
            path.unlink(missing_ok=True)
            self.say_next()
            return
        self.temp_files[pb] = path
        self.saying = pb
        self.saying_file = (path, to_pc)

    def stop_speech(self, pc_only=False):
        """Forget waiting lines and stop the one being made or spoken. With pc_only
        (the headset went away), lines for the phone only carry on."""
        self.say_queue[:] = [q for q in self.say_queue if pc_only and not q[1]]
        if self.saying is None or (pc_only and not self.saying_file[1]):
            return
        saying, self.saying = self.saying, None
        path, _ = self.saying_file
        self.saying_file = None
        if isinstance(saying, Gio.Subprocess):
            saying.force_exit()
            path.unlink(missing_ok=True)  # now: on close, said() may never run
        else:
            self.drop_effect(saying)
        self.say_next()


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="local.UsbMic")

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    Gst.init(None)
    sys.exit(App().run(sys.argv))
