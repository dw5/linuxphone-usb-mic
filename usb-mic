def pactl(*args):
    """Run pactl and return its output; "" if it fails or PulseAudio doesn't answer
    within 3 s (this runs on the GTK thread, so it must not hang)."""
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True,
                              timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


_devices = {}  # kind -> (when, list): one refresh asks PulseAudio once per kind


def devices(kind, fresh=False):
    when, found = _devices.get(kind, (0.0, []))
    if fresh or time.monotonic() - when > 0.5:
        try:
            found = json.loads(pactl("-f", "json", "list", kind) or "[]")
        except ValueError:
            found = []
        _devices[kind] = (time.monotonic(), found)
    return found


def make(factory):
    """A GStreamer element, or an error naming the missing plugin."""
    e = Gst.ElementFactory.make(factory, None)
    if e is None:
        raise RuntimeError(f"GStreamer element \"{factory}\" is missing")
    return e


def is_gadget(dev):
    return "Gadget" in (dev.get("properties", {}).get("alsa.card_name") or "")


def is_sound(dev):
    return dev.get("properties", {}).get("device.class") == "sound"


def gadget_sink():
    """PulseAudio's name for the microphone's sink (what the PC records), or None."""
    return next((d["name"] for d in devices("sinks") if is_gadget(d)), None)


def gadget_source():
    """PulseAudio's name for the speaker side (what the PC plays), or None."""
    return next((d["name"] for d in devices("sources") if is_gadget(d) and is_sound(d)), None)


def phone_mic():
    """The phone's own microphone: the default source unless that's the USB one."""
    mics = [d for d in devices("sources") if not is_gadget(d) and is_sound(d)]
    default = pactl("get-default-source")
    for d in mics:
        if d["name"] == default:
            return default
    return mics[0]["name"] if mics else None


def phone_speaker():
    """The phone's own output: the default sink unless that's the USB one (PulseAudio
    switches the default to it when the headset appears)."""
    outs = [d for d in devices("sinks") if not is_gadget(d) and is_sound(d)]
    default = pactl("get-default-sink")
    for d in outs:
        if d["name"] == default:
            return default
    return outs[0]["name"] if outs else None


def choices(kind):
    """The phone's own outputs ("sinks") or inputs ("sources") to pick from, as
    (key, label, device, port). The first entry leaves it to the phone. A device with
    several usable ports (speaker, earpiece) gets one entry per port."""
    out = [("", "Phone's choice", None, None)]
    for d in devices(kind):
        if is_gadget(d) or not is_sound(d):
            continue
        ports = [p for p in d.get("ports", []) if p.get("availability") != "not available"]
        # The phone's built-in device is called just "Input"/"Output"; its ports say more.
        if len(ports) > 1 or (ports and d.get("description") in ("Input", "Output")):
            out += [(f"{d['name']}#{p['name']}", p.get("description") or p["name"], d["name"], p["name"])
                    for p in ports]
        else:
            out.append((d["name"], d.get("description") or d["name"], d["name"], None))
    return out


def active_port(kind, device):
    return next((d.get("active_port") for d in devices(kind, fresh=True) if d["name"] == device), None)


def available_effects():
    """The effects this phone can build, first working choice per key."""
    found, seen = [], set()
    for key, name, desc in EFFECTS:
        if key in seen:
            continue
        try:
            Gst.parse_bin_from_description(f"audioconvert ! {desc} ! audioconvert", True)
        except GLib.Error:
            continue
        found.append((key, name, desc))
        seen.add(key)
    return found


def tts_voices():
    """Voices to speak typed text with, as (key, label, command). The command takes the
    text on stdin and gets the file to write appended."""
    out = []
    piper = shutil.which("piper") or (str(TTS_HOME / "piper" / "piper")
                                      if os.access(TTS_HOME / "piper" / "piper", os.X_OK) else None)
    if piper:
        for model in sorted((TTS_HOME / "voices").glob("*.onnx")):
            if model.with_suffix(".onnx.json").exists():
                # en_US-lessac-medium -> "Lessac (en_US)"
                lang, _, rest = model.stem.partition("-")
                name = rest.rsplit("-", 1)[0].replace("_", " ").title() or model.stem
                out.append((f"piper:{model.name}", f"{name} ({lang})",
                            [piper, "--model", str(model), "--output_file"]))
    espeak = shutil.which("espeak-ng")
    if espeak:
        out += [(f"espeak:{v}", f"{label}, robotic", [espeak, "-v", v, "--stdin", "-w"])
                for v, label in ESPEAK_VOICES]
    return out


def timecode(ns):
    s = max(0, ns) // Gst.SECOND
    return f"{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def mic_on():
    return os.path.lexists(GADGET_LINK)


