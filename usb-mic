# need the swh-plugins (ring modulator) and rubberband-ladspa packages. Delays are in
# nanoseconds; LADSPA plugins here take mono 32-bit float.
RINGMOD = "audio/x-raw,format=F32LE,channels=1 ! ladspa-ringmod-1188-so-ringmod-1i1o1l"
