#!/bin/sh
# Root helper for the USB Mic app: adds or removes a USB microphone (UAC1) on the
# phone's running USB gadget. In memory only; a reboot removes it. Usage: on | off
set -e
G=/sys/kernel/config/usb_gadget/g1
F=functions/uac1.mic
# Windows caches a device's descriptors by vendor, product and bcdDevice, so a
# changed set of functions needs its own bcdDevice to be seen (as glkvm does).
MIC_BCD=0x0304  # each digit 0-9: the kernel rejects others
SAVED=/run/usb-mic-bcddevice
# Other functions linked before the mic was added. They come off while it's on:
# on this kernel the serial port carries an IAD and UAC1 doesn't, and Windows then
# splits the mic's interfaces apart and fails to start it (problem code 10).
LINKS=/run/usb-mic-links
# Device name and serial shown to the PC while the mic is on (the phone's own
# include "FLX1s"). The mic's terminal names are fixed in this kernel's f_uac1.
MIC_PRODUCT="Terminal Headset"
MIC_SERIAL="TH0001"
NAMES=/run/usb-mic-names
[ -d "$G" ] || { echo "no USB gadget g1" >&2; exit 1; }
cd "$G"
udc=$(cat UDC)
[ -n "$udc" ] || udc=$(ls /sys/class/udc | head -n1)

# Whatever happens below, leave USB bound, or the phone drops off the PC.
trap '[ -n "$(cat UDC)" ] || echo "$udc" > UDC' EXIT

unlink_mic() {
    for f in configs/c.1/uac*.mic; do [ -L "$f" ] && rm "$f"; done
    for f in functions/uac*.mic; do [ -d "$f" ] && rmdir "$f"; done
    return 0
}

case "$1" in
on)
    echo "" > UDC || true
    unlink_mic
    mkdir "$F"
    # p_* is the phone's playback, which the PC sees as a microphone. The c_* side
    # (a PC speaker) stays on with one channel: with it off, this kernel advertises
    # a broken endpoint.
    echo 3 > "$F/p_chmask"; echo 48000 > "$F/p_srate"; echo 2 > "$F/p_ssize"
    echo 1 > "$F/c_chmask"; echo 48000 > "$F/c_srate"; echo 2 > "$F/c_ssize"
    if [ ! -f "$LINKS" ]; then
        for f in configs/c.1/*.*; do [ -L "$f" ] && basename "$f"; done > "$LINKS"
    fi
    while read -r f; do rm -f "configs/c.1/$f"; done < "$LINKS"
    ln -s "$F" configs/c.1/
    [ -f "$SAVED" ] || cat bcdDevice > "$SAVED"
    [ -f "$NAMES" ] || { cat strings/0x409/product; cat strings/0x409/serialnumber; } > "$NAMES"
    echo "$MIC_PRODUCT" > strings/0x409/product
    echo "$MIC_SERIAL" > strings/0x409/serialnumber
    echo "$MIC_BCD" > bcdDevice
    echo "$udc" > UDC
    ;;
off)
    echo "" > UDC || true
    unlink_mic
    if [ -f "$LINKS" ]; then
        while read -r f; do [ -e "configs/c.1/$f" ] || ln -s "functions/$f" configs/c.1/; done < "$LINKS"
        rm -f "$LINKS"
    fi
    if [ -f "$SAVED" ]; then cat "$SAVED" > bcdDevice; rm -f "$SAVED"; fi
    if [ -f "$NAMES" ]; then
        { read -r product; read -r serial; } < "$NAMES"
        echo "$product" > strings/0x409/product
        echo "$serial" > strings/0x409/serialnumber
        rm -f "$NAMES"
    fi
    echo "$udc" > UDC
    ;;
*)
    echo "usage: $0 on|off" >&2; exit 2 ;;
esac
